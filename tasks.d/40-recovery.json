[
  {
    "label": "Merge: abort",
    "command": "__ZGT_RUN__",
    "args": [
      "--confirm",
      "--require", "merge",
      "--message", "進行中のマージを中止し、マージ前の状態に戻します (コンフリクトの解決内容は失われます)。",
      "--",
      "git", "merge", "--abort"
    ],
    "hide": "on_success",
    "tags": ["git-command"]
  },
  {
    "label": "Rebase: continue",
    "command": "__ZGT_RUN__",
    "args": [
      "--require", "rebase",
      "--",
      "git", "rebase", "--continue"
    ],
    "env": { "GIT_EDITOR": "true" },
    "hide": "on_success",
    "tags": ["git-command"]
  },
  {
    "label": "Rebase: abort",
    "command": "__ZGT_RUN__",
    "args": [
      "--confirm",
      "--require", "rebase",
      "--message", "進行中のリベースを中止し、リベース前の状態に戻します。",
      "--",
      "git", "rebase", "--abort"
    ],
    "hide": "on_success",
    "tags": ["git-command"]
  }
]
