#!/usr/bin/env bash
# zed-git-graph-tasks の実行ラッパー。内容を表示し、確認してからコマンドを実行する。
#
# 汎用:
#   zgt-run [--confirm | --danger] [--message TEXT] [--note TEXT]
#           [--require OP] -- <command> [args...]
#
#   --confirm   y/N で確認する
#   --danger    "yes" と入力しないと実行しない
#   --message   確認の前に表示する説明
#   --note      成功したときに表示する補足
#   --require   OP (merge / rebase / cherry-pick / revert) が途中でなければ何もしない
#
# 組み込みの操作 (<ref> に @ を渡すと「ref なし」= コミット行から開いた扱い):
#   zgt-run checkout <sha> <ref|@>         ref があればブランチか detached HEAD かを選ぶ。無ければ detached HEAD
#   zgt-run create-branch <sha>            名前を入力してブランチを作る (チェックアウトするかも聞く)
#   zgt-run merge <sha> <ref|@>            ref (無ければコミット) を現在のブランチにマージする。方法を選ぶ
#   zgt-run rebase <sha> <ref|@>           現在のブランチを ref (無ければコミット) の上にリベースする。方法を選ぶ
#   zgt-run cherry-pick <sha> [options]    cherry-pick する。options が無ければ方法を選ぶ
#   zgt-run revert <sha> [options]         revert する (マージコミットは第 1 親を基準にする)
#   zgt-run push <branch> [remote]         ローカルブランチを push する。方法と upstream の有無を選ぶ (既定の remote は origin)
#   zgt-run continue                       途中で止まっている merge / rebase / cherry-pick / revert を続行する
#   zgt-run abort                          同上を中止する
set -u

mode=run
message=""
note=""
target=""
repo=""
CHOICE=""

if [ -t 1 ]; then
  B=$'\033[1m' R=$'\033[31m' G=$'\033[32m' Y=$'\033[33m' D=$'\033[2m' N=$'\033[0m'
else
  B="" R="" G="" Y="" D="" N=""
fi

usage_error() {
  printf 'zgt-run: %s\n' "$1" >&2
  exit 2
}

# 何もせずに終わる。成功扱いにするとタスクのターミナルがすぐ閉じて理由が読めないので 1 で終える
nothing_to_do() {
  printf '%s\n' "$1"
  exit 1
}

cancelled() {
  printf '%sキャンセルしました。%s\n' "$D" "$N"
  exit 0
}

git_has() { git rev-parse -q --verify "$1" >/dev/null 2>&1; }

# 右クリックした ref があるか (コミット行から開いたときは @ か空)
has_ref() { [ -n "$1" ] && [ "$1" != "@" ]; }

in_rebase() {
  [ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" ] && return 0
  local apply
  apply="$(git rev-parse --git-path rebase-apply 2>/dev/null)"
  # rebase-apply は git am でも使われる。am のときは applying ファイルがある
  [ -d "$apply" ] && [ ! -e "$apply/applying" ]
}

# 途中で止まっている操作の名前を出力する (無ければ何も出力しない)
current_op() {
  if in_rebase; then
    echo rebase
  elif git_has MERGE_HEAD; then
    echo merge
  elif git_has CHERRY_PICK_HEAD; then
    echo cherry-pick
  elif git_has REVERT_HEAD; then
    echo revert
  fi
}

current_branch() {
  git symbolic-ref --short -q HEAD 2>/dev/null ||
    printf '(detached HEAD %s)\n' "$(git rev-parse --short HEAD 2>/dev/null)"
}

commit_summary() {
  git log -1 --format='%h %s' "$1" 2>/dev/null || printf '%s\n' "$1"
}

count_args() { echo $#; }

require_repo() {
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%sGit リポジトリではありません: %s%s\n' "$R" "$PWD" "$N"
    exit 1
  }
}

require_commit() {
  git_has "$1^{commit}" || nothing_to_do "コミットが見つかりません: $1"
}

show_context() {
  printf '%sリポジトリ%s     %s\n' "$B" "$N" "$repo"
  printf '%s現在のブランチ%s %s\n' "$B" "$N" "$(current_branch)"
  [ -n "$target" ] && printf '%s対象%s           %s\n' "$B" "$N" "$target"
  return 0
}

show_command() {
  local cmdline
  cmdline="$(printf '%q ' "$@")"
  printf '%sコマンド%s       %s\n' "$B" "$N" "${cmdline% }"
}

show_message() {
  [ -n "$message" ] && printf '\n%s%s%s\n' "$Y" "$message" "$N"
  return 0
}

is_yes() {
  case "$1" in
    y | Y | yes | Yes | YES) return 0 ;;
  esac
  return 1
}

# confirm: y/N   danger: "yes" の入力が必要   run: 確認しない
ask() {
  local ans=""
  case "$1" in
    confirm)
      printf '\n実行しますか? [y/N] '
      IFS= read -r ans || ans=""
      is_yes "$ans" || cancelled
      ;;
    danger)
      printf '\n%s実行するには yes と入力してください:%s ' "$R" "$N"
      IFS= read -r ans || ans=""
      [ "$ans" = "yes" ] || cancelled
      ;;
  esac
}

# choose <見出し> <選択肢...>
# 番号で選ばせ、その番号を CHOICE に入れる。番号を選ぶことを実行の確認とみなす。空入力 / q でキャンセル
choose() {
  local title="$1" i=1 opt ans
  shift
  printf '\n%s\n' "$title"
  for opt in "$@"; do
    printf '  %s%d)%s %s\n' "$B" "$i" "$N" "$opt"
    i=$((i + 1))
  done
  while :; do
    printf '番号を選んでください (空 / q でキャンセル): '
    IFS= read -r ans || ans=""
    case "$ans" in
      "" | q | Q) cancelled ;;
      *[!0-9]*) ;;
      *)
        if [ "$ans" -ge 1 ] && [ "$ans" -le $# ]; then
          CHOICE="$ans"
          return 0
        fi
        ;;
    esac
    printf '%s1〜%d の番号を入力してください。%s\n' "$R" $# "$N"
  done
}

# コマンドを実行し、結果と次にやることを表示して、その終了コードで終える
execute() {
  local status op
  echo
  "$@"
  status=$?
  if [ "$status" -eq 0 ]; then
    printf '\n%s✓ 完了%s\n' "$G" "$N"
    if [ -n "$note" ]; then
      printf '%s\n' "$note"
      # 補足を読めるよう、閉じる前に待つ (成功時にターミナルを閉じるタスク向け)
      printf '%s(Enter で閉じます)%s' "$D" "$N"
      IFS= read -r _ || true
    fi
  else
    printf '\n%s✗ 失敗しました (exit %d)%s\n' "$R" "$status" "$N"
    op="$(current_op)"
    if [ -n "$op" ]; then
      printf '%s が途中で止まっています。コンフリクトを解決してステージし、Custom Commands の「Continue」を実行してください (中止は「Abort」)。\n' "$op"
      [ "$op" = merge ] && echo "マージは Git Panel からコミットしても完了できます。"
    fi
  fi
  exit "$status"
}

# merge / rebase の対象を決める。ref があれば ref、無ければコミット。rev / disp / target を設定する
resolve_target() {
  local sha="$1" ref="$2"
  if has_ref "$ref"; then
    git_has "$ref^{commit}" || nothing_to_do "見つかりません: $ref"
    rev="$ref"
    disp="$ref"
    target="$ref ($(commit_summary "$ref"))"
  else
    require_commit "$sha"
    rev="$sha"
    disp="$(git rev-parse --short "$sha")"
    target="$(commit_summary "$sha")"
  fi
}

run_generic() {
  local require=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) mode=confirm ;;
      --danger) mode=danger ;;
      --message | --note | --require)
        [ $# -ge 2 ] || usage_error "$1 には値が必要です"
        case "$1" in
          --message) message="$2" ;;
          --note) note="$2" ;;
          --require) require="$2" ;;
        esac
        shift
        ;;
      --)
        shift
        break
        ;;
      *) usage_error "不明なオプション: $1" ;;
    esac
    shift
  done
  [ $# -gt 0 ] || usage_error "実行するコマンドがありません"

  require_repo
  case "$require" in
    "") ;;
    merge | rebase | cherry-pick | revert)
      [ "$(current_op)" = "$require" ] || nothing_to_do "途中で止まっている $require はありません。"
      ;;
    *) usage_error "--require には merge / rebase / cherry-pick / revert のどれかを指定してください" ;;
  esac

  show_context
  show_command "$@"
  show_message
  ask "$mode"
  execute "$@"
}

# ref (ローカルブランチ / リモートブランチ / タグ) をチェックアウトする方法を決める
# plan_kind: branch / tag / current / missing   plan_desc: 説明   plan_cmd_*: コマンド
plan_ref_checkout() {
  local ref="$1" head remote r local_name upstream
  head="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
  plan_kind=branch
  if git_has "refs/heads/$ref"; then
    if [ "$head" = "$ref" ]; then
      plan_kind=current
      plan_desc="$ref は既にチェックアウトしています。"
      return
    fi
    plan_desc="ブランチ $ref に切り替える"
    plan_cmd="switch"
    plan_args="$ref"
  elif git_has "refs/remotes/$ref"; then
    remote=""
    for r in $(git remote); do
      case "$ref" in
        "$r"/*) [ ${#r} -gt ${#remote} ] && remote="$r" ;;
      esac
    done
    if [ -z "$remote" ]; then
      plan_kind=missing
      plan_desc="リモート名を判別できません: $ref"
      return
    fi
    local_name="${ref#"$remote"/}"
    if git_has "refs/heads/$local_name"; then
      if [ "$head" = "$local_name" ]; then
        plan_kind=current
        plan_desc="$local_name は既にチェックアウトしています。"
        return
      fi
      upstream="$(git rev-parse --abbrev-ref "$local_name@{upstream}" 2>/dev/null || true)"
      if [ "$upstream" = "$ref" ]; then
        plan_desc="$ref を追跡しているローカルブランチ $local_name に切り替える"
      else
        plan_desc="既にあるローカルブランチ $local_name に切り替える (追跡先: ${upstream:-なし})"
      fi
      plan_cmd="switch"
      plan_args="$local_name"
    else
      plan_desc="$ref を追跡するローカルブランチ $local_name を作って切り替える"
      plan_cmd="track"
      plan_args="$local_name"
    fi
  elif git_has "refs/tags/$ref"; then
    plan_kind=tag
    plan_desc="タグ $ref を detached HEAD でチェックアウトします。"
  else
    plan_kind=missing
    plan_desc="ブランチ / タグが見つかりません: $ref"
  fi
}

run_checkout() {
  [ $# -eq 2 ] || usage_error "使い方: zgt-run checkout <sha> <ref|@>"
  local sha="$1" ref="$2" short already=0
  require_repo
  require_commit "$sha"
  short="$(git rev-parse --short "$sha")"
  if ! git symbolic-ref -q HEAD >/dev/null 2>&1 &&
    [ "$(git rev-parse HEAD)" = "$(git rev-parse "$sha^{commit}")" ]; then
    already=1
  fi

  if has_ref "$ref"; then
    # origin/HEAD などのシンボリック ref は、指している先に置き換える
    if git symbolic-ref -q "refs/remotes/$ref" >/dev/null 2>&1; then
      ref="$(git symbolic-ref --short "refs/remotes/$ref")"
    fi
    target="$ref ($(commit_summary "$sha"))"
    plan_ref_checkout "$ref"
    case "$plan_kind" in
      current | missing) nothing_to_do "$plan_desc" ;;
      tag)
        message="$plan_desc"
        set -- git switch --detach "$ref"
        ;;
      branch)
        show_context
        choose "チェックアウトの方法を選んでください:" \
          "$plan_desc" \
          "コミット $short を detached HEAD でチェックアウトする"
        if [ "$CHOICE" = 1 ]; then
          if [ "$plan_cmd" = track ]; then
            set -- git switch -c "$plan_args" --track "$ref"
          else
            set -- git switch "$plan_args"
          fi
        else
          [ "$already" = 1 ] && nothing_to_do "既にこのコミットをチェックアウトしています。"
          set -- git switch --detach "$sha"
        fi
        echo
        show_command "$@"
        execute "$@"
        ;;
    esac
  else
    target="$(commit_summary "$sha")"
    [ "$already" = 1 ] && nothing_to_do "既にこのコミットをチェックアウトしています。"
    message="このコミットを detached HEAD でチェックアウトします。ここで作業を続けるならブランチを作ってください。"
    set -- git switch --detach "$sha"
  fi

  show_context
  show_command "$@"
  show_message
  ask confirm
  execute "$@"
}

run_create_branch() {
  [ $# -eq 1 ] || usage_error "使い方: zgt-run create-branch <sha>"
  local sha="$1" name ans
  require_repo
  require_commit "$sha"
  target="$(commit_summary "$sha")"
  show_context

  while :; do
    printf '\n新しいブランチ名 (空でキャンセル): '
    IFS= read -r name || name=""
    # 前後の空白を取り除く
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [ -n "$name" ] || cancelled
    if ! git check-ref-format --branch "$name" >/dev/null 2>&1; then
      printf '%sブランチ名として使えません: %s%s\n' "$R" "$name" "$N"
      continue
    fi
    if git_has "refs/heads/$name"; then
      printf '%s既にあります: %s%s\n' "$R" "$name" "$N"
      continue
    fi
    break
  done

  printf 'チェックアウトもしますか? [y/N] '
  IFS= read -r ans || ans=""
  if is_yes "$ans"; then
    set -- git switch -c "$name" "$sha"
  else
    set -- git branch "$name" "$sha"
  fi
  echo
  show_command "$@"
  execute "$@"
}

run_merge() {
  [ $# -eq 2 ] || usage_error "使い方: zgt-run merge <sha> <ref|@>"
  require_repo
  resolve_target "$1" "$2"
  [ "$rev" = "$(git symbolic-ref --short -q HEAD)" ] && nothing_to_do "現在のブランチ自身はマージできません。"
  show_context
  choose "$disp を現在のブランチにマージします。方法を選んでください:" \
    "通常        git merge" \
    "--no-ff     fast-forward できる場合もマージコミットを作る" \
    "--squash    変更を 1 つにまとめてステージする (コミットはしない)"
  case "$CHOICE" in
    1) set -- git merge --no-edit "$rev" ;;
    2) set -- git merge --no-ff --no-edit "$rev" ;;
    3)
      set -- git merge --squash "$rev"
      note="変更はステージ済みです。Git Panel からコミットしてください。"
      ;;
  esac
  echo
  show_command "$@"
  execute "$@"
}

run_rebase() {
  [ $# -eq 2 ] || usage_error "使い方: zgt-run rebase <sha> <ref|@>"
  require_repo
  resolve_target "$1" "$2"
  show_context
  choose "現在のブランチを $disp の上にリベースします。方法を選んでください:" \
    "通常           git rebase" \
    "interactive    git rebase -i (Git に設定したエディタでコミットを並べ替え・編集する)"
  case "$CHOICE" in
    1) set -- git rebase "$rev" ;;
    2) set -- git rebase -i "$rev" ;;
  esac
  echo
  show_command "$@"
  execute "$@"
}

# run_pick cherry-pick|revert <sha> [options...]
run_pick() {
  local op="$1" sha="$2" parents merge_commit=0 chosen=0 arg
  shift 2
  require_repo
  require_commit "$sha"
  target="$(commit_summary "$sha")"
  # shellcheck disable=SC2046
  parents="$(count_args $(git rev-list --parents -n 1 "$sha"))"
  [ "$parents" -gt 2 ] && merge_commit=1

  case "$op" in
    cherry-pick) message="このコミットの変更を現在のブランチに取り込みます。" ;;
    revert) message="このコミットを打ち消すコミットを現在のブランチに作ります。" ;;
  esac
  [ "$merge_commit" = 1 ] && message="$message マージコミットなので、第 1 親を基準にします (-m 1)。"

  if [ "$op" = cherry-pick ] && [ $# -eq 0 ]; then
    show_context
    show_message
    choose "取り込み方を選んでください:" \
      "通常          git cherry-pick" \
      "-x            元のコミットをメッセージに記録する" \
      "--no-commit   変更だけ取り込んでステージする (コミットはしない)"
    case "$CHOICE" in
      2) set -- -x ;;
      3) set -- --no-commit ;;
    esac
    chosen=1
  fi

  case "$op" in
    cherry-pick) set -- git cherry-pick "$@" ;;
    revert) set -- git revert --no-edit "$@" ;;
  esac
  [ "$merge_commit" = 1 ] && set -- "$@" -m 1
  set -- "$@" "$sha"
  for arg in "$@"; do
    case "$arg" in
      -n | --no-commit) note="変更はステージ済みです。Git Panel からコミットしてください。" ;;
    esac
  done

  if [ "$chosen" = 1 ]; then
    echo
    show_command "$@"
    execute "$@"
  fi
  show_context
  show_command "$@"
  show_message
  ask confirm
  execute "$@"
}

# ブランチの upstream を "remote/branch" の形で出力する (無ければ何も出力しない)
branch_upstream() {
  local up_remote up_merge
  up_remote="$(git config "branch.$1.remote" 2>/dev/null)" || return 0
  up_merge="$(git config "branch.$1.merge" 2>/dev/null)" || return 0
  if [ "$up_remote" = "." ]; then
    printf '%s (ローカルブランチ)\n' "${up_merge#refs/heads/}"
  else
    printf '%s/%s\n' "$up_remote" "${up_merge#refs/heads/}"
  fi
}

run_push() {
  { [ $# -ge 1 ] && [ $# -le 2 ]; } || usage_error "使い方: zgt-run push <branch> [remote]"
  local branch="$1" remote="${2:-origin}" refspec counts upstream ans
  local set_upstream=""
  require_repo
  git_has "refs/heads/$branch" || nothing_to_do "$branch はローカルブランチではないので push できません。"
  git remote get-url "$remote" >/dev/null 2>&1 || nothing_to_do "リモート $remote がありません。"
  if git_has "refs/remotes/$remote/$branch"; then
    counts="$(git rev-list --left-right --count "refs/heads/$branch...refs/remotes/$remote/$branch")"
    target="$branch → $remote ($remote/$branch より ${counts%%[[:space:]]*} コミット先行 / ${counts##*[[:space:]]} コミット遅れ。最後の fetch 時点)"
  else
    target="$branch → $remote ($remote にはまだありません)"
  fi
  refspec="refs/heads/$branch:refs/heads/$branch"
  upstream="$(branch_upstream "$branch")"

  show_context
  printf '%supstream%s       %s\n' "$B" "$N" "${upstream:-なし}"
  choose "push の方法を選んでください:" \
    "通常                git push" \
    "force-with-lease    上書きする。最後に fetch した後で他の人が push していれば中止する" \
    "force               無条件に上書きする (他の人が push したコミットも消える)"

  # 既に同じ upstream なら -u を付けても変わらないので聞かない
  if [ "$upstream" != "$remote/$branch" ]; then
    printf 'upstream を %s に設定しますか? (現在: %s) [y/N] ' "$remote/$branch" "${upstream:-なし}"
    IFS= read -r ans || ans=""
    is_yes "$ans" && set_upstream="-u"
  fi

  case "$CHOICE" in
    1) set -- git push ;;
    2)
      mode=danger
      message="$remote/$branch をローカルの $branch で上書きします。最後に fetch した後で他の人が push していた場合は中止されます。"
      set -- git push --force-with-lease --force-if-includes
      ;;
    3)
      mode=danger
      message="$remote/$branch を無条件に上書きします。他の人が push したコミットも消えます。"
      set -- git push --force
      ;;
  esac
  [ -n "$set_upstream" ] && set -- "$@" "$set_upstream"
  set -- "$@" "$remote" "$refspec"
  echo
  show_command "$@"
  show_message
  ask "$mode"
  execute "$@"
}

run_continue() {
  [ $# -eq 0 ] || usage_error "使い方: zgt-run continue"
  local op unmerged
  require_repo
  op="$(current_op)"
  [ -n "$op" ] || nothing_to_do "途中で止まっている merge / rebase / cherry-pick / revert はありません。"
  unmerged="$(git diff --name-only --diff-filter=U)"
  if [ -n "$unmerged" ]; then
    printf '%s未解決のコンフリクトがあります。解決してステージしてから、もう一度実行してください:%s\n%s\n' \
      "$R" "$N" "$unmerged"
    exit 1
  fi
  # コミットメッセージのエディタを開かず、Git が用意したメッセージをそのまま使う
  export GIT_EDITOR=true
  message="途中で止まっている $op を続行します (エディタは開かず、Git が用意したメッセージを使います)。"
  set -- git "$op" --continue

  show_context
  show_command "$@"
  show_message
  execute "$@"
}

run_abort() {
  [ $# -eq 0 ] || usage_error "使い方: zgt-run abort"
  local op
  require_repo
  op="$(current_op)"
  [ -n "$op" ] || nothing_to_do "途中で止まっている merge / rebase / cherry-pick / revert はありません。"
  message="途中で止まっている $op を中止し、始める前の状態に戻します (コンフリクトの解決内容は失われます)。"
  set -- git "$op" --abort

  show_context
  show_command "$@"
  show_message
  ask confirm
  execute "$@"
}

case "${1-}" in
  checkout | create-branch | merge | rebase | push | continue | abort)
    cmd="$1"
    shift
    case "$cmd" in
      checkout) run_checkout "$@" ;;
      create-branch) run_create_branch "$@" ;;
      merge) run_merge "$@" ;;
      rebase) run_rebase "$@" ;;
      push) run_push "$@" ;;
      continue) run_continue "$@" ;;
      abort) run_abort "$@" ;;
    esac
    ;;
  cherry-pick | revert)
    [ $# -ge 2 ] || usage_error "使い方: zgt-run $1 <sha> [options]"
    run_pick "$@"
    ;;
  *) run_generic "$@" ;;
esac
