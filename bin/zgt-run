#!/usr/bin/env bash
# zed-git-graph-tasks の実行ラッパー。内容を表示し、確認してからコマンドを実行する。
# 表示の文言は同じディレクトリの messages.sh (install.sh が lang/<言語>.sh をコピーする) から読む。
# リポジトリから直接実行したときは ../lang/${ZGT_LANG:-en}.sh を読む。
#
# 汎用:
#   zgt-run [--confirm | --danger] [--message TEXT] [--note TEXT]
#           [--require OP] -- <command> [args...]
#
#   --confirm   y/N で確認する
#   --danger    "yes" と入力しないと実行しない
#   --message   確認の前に表示する説明
#   --note      成功したときに表示する補足
#   --require   OP (merge / rebase / cherry-pick / revert) が途中でなければ何もしない
#
# 組み込みの操作 (<ref> に @ を渡すと「ref なし」= コミット行から開いた扱い):
#   zgt-run checkout <sha> <ref|@>         ref があればブランチか detached HEAD かを選ぶ。無ければ detached HEAD
#   zgt-run create-branch <sha>            名前を入力してブランチを作る (チェックアウトするかも聞く)
#   zgt-run merge <sha> <ref|@>            ref (無ければコミット) を現在のブランチにマージする。方法を選ぶ
#   zgt-run rebase <sha> <ref|@>           現在のブランチを ref (無ければコミット) の上にリベースする。方法を選ぶ
#   zgt-run cherry-pick <sha> [options]    cherry-pick する。options が無ければ方法を選ぶ
#   zgt-run revert <sha> [options]         revert する (マージコミットは第 1 親を基準にする)
#   zgt-run push <branch> [remote]         ローカルブランチを push する。remote を省くとリモートを選ぶ (1 つなら聞かない)。方法と upstream の有無も選ぶ
#   zgt-run continue                       途中で止まっている merge / rebase / cherry-pick / revert を続行する
#   zgt-run abort                          同上を中止する
set -u

zgt_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$zgt_dir/messages.sh" ]; then
  # shellcheck source=/dev/null
  . "$zgt_dir/messages.sh"
else
  # shellcheck source=/dev/null
  . "$zgt_dir/../lang/${ZGT_LANG:-en}.sh" || exit 2
fi

mode=run
message=""
note=""
target=""
repo=""
CHOICE=""

if [ -t 1 ]; then
  B=$'\033[1m' R=$'\033[31m' G=$'\033[32m' Y=$'\033[33m' D=$'\033[2m' N=$'\033[0m'
else
  B="" R="" G="" Y="" D="" N=""
fi

# msg <キー> [値...]: 言語ファイルの MSG_<キー> を書式にして値を差し込み、出力する (改行なし)
msg() {
  local _fmt="MSG_$1"
  shift
  # shellcheck disable=SC2059
  printf -- "${!_fmt}" "$@"
}

usage_error() {
  printf 'zgt-run: %s\n' "$1" >&2
  exit 2
}

usage() { usage_error "$(msg USAGE "zgt-run $1")"; }

# 何もせずに終わる。成功扱いにするとタスクのターミナルがすぐ閉じて理由が読めないので 1 で終える
nothing_to_do() {
  printf '%s\n' "$1"
  exit 1
}

cancelled() {
  printf '%s%s%s\n' "$D" "$(msg CANCELLED)" "$N"
  exit 0
}

git_has() { git rev-parse -q --verify "$1" >/dev/null 2>&1; }

# 右クリックした ref があるか (コミット行から開いたときは @ か空)
has_ref() { [ -n "$1" ] && [ "$1" != "@" ]; }

in_rebase() {
  [ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" ] && return 0
  local apply
  apply="$(git rev-parse --git-path rebase-apply 2>/dev/null)"
  # rebase-apply は git am でも使われる。am のときは applying ファイルがある
  [ -d "$apply" ] && [ ! -e "$apply/applying" ]
}

# 途中で止まっている操作の名前を出力する (無ければ何も出力しない)
current_op() {
  if in_rebase; then
    echo rebase
  elif git_has MERGE_HEAD; then
    echo merge
  elif git_has CHERRY_PICK_HEAD; then
    echo cherry-pick
  elif git_has REVERT_HEAD; then
    echo revert
  fi
}

current_branch() {
  git symbolic-ref --short -q HEAD 2>/dev/null ||
    printf '(detached HEAD %s)\n' "$(git rev-parse --short HEAD 2>/dev/null)"
}

commit_summary() {
  git log -1 --format='%h %s' "$1" 2>/dev/null || printf '%s\n' "$1"
}

count_args() { echo $#; }

require_repo() {
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '%s%s%s\n' "$R" "$(msg NOT_REPO "$PWD")" "$N"
    exit 1
  }
}

require_commit() {
  git_has "$1^{commit}" || nothing_to_do "$(msg COMMIT_NOT_FOUND "$1")"
}

# show_field <ラベルのキー> <値>  (ラベルは言語ファイル側で桁を揃えて空白まで含めている)
show_field() {
  printf '%s%s%s%s\n' "$B" "$(msg "$1")" "$N" "$2"
}

show_context() {
  show_field LABEL_REPO "$repo"
  show_field LABEL_BRANCH "$(current_branch)"
  [ -n "$target" ] && show_field LABEL_TARGET "$target"
  return 0
}

show_command() {
  local cmdline
  cmdline="$(printf '%q ' "$@")"
  show_field LABEL_COMMAND "${cmdline% }"
}

show_message() {
  [ -n "$message" ] && printf '\n%s%s%s\n' "$Y" "$message" "$N"
  return 0
}

is_yes() {
  case "$1" in
    y | Y | yes | Yes | YES) return 0 ;;
  esac
  return 1
}

# confirm: y/N   danger: "yes" の入力が必要   run: 確認しない
ask() {
  local ans=""
  case "$1" in
    confirm)
      printf '\n%s' "$(msg ASK_CONFIRM)"
      IFS= read -r ans || ans=""
      is_yes "$ans" || cancelled
      ;;
    danger)
      printf '\n%s%s%s ' "$R" "$(msg ASK_DANGER)" "$N"
      IFS= read -r ans || ans=""
      [ "$ans" = "yes" ] || cancelled
      ;;
  esac
}

# choose <見出し> <選択肢...>
# 番号で選ばせ、その番号を CHOICE に入れる。番号を選ぶことを実行の確認とみなす。空入力 / q でキャンセル
choose() {
  local title="$1" i=1 opt ans
  shift
  printf '\n%s\n' "$title"
  for opt in "$@"; do
    printf '  %s%d)%s %s\n' "$B" "$i" "$N" "$opt"
    i=$((i + 1))
  done
  while :; do
    msg CHOOSE_PROMPT
    IFS= read -r ans || ans=""
    case "$ans" in
      "" | q | Q) cancelled ;;
      *[!0-9]*) ;;
      *)
        if [ "$ans" -ge 1 ] && [ "$ans" -le $# ]; then
          CHOICE="$ans"
          return 0
        fi
        ;;
    esac
    printf '%s%s%s\n' "$R" "$(msg CHOOSE_INVALID $#)" "$N"
  done
}

# choose_name <見出し> <選択肢...>
# 名前の一覧から 1 つ選ばせ、その番号を CHOICE に入れる。
# fzf があれば fzf で絞り込んで選ぶ (Enter でカーソルのある行を選ぶ。Esc / Ctrl-C / 該当なしはキャンセル)。
# fzf が無い / 使えない (端末が無いなど) ときは choose と同じ番号選択にする。
# 使う fzf は環境変数 ZGT_FZF で差し替えられる (主にテスト用)
choose_name() {
  local title="$1" fzf="${ZGT_FZF:-fzf}" tab i=1 opt line status
  shift
  tab="$(printf '\t')"
  if command -v "$fzf" >/dev/null 2>&1; then
    # 「番号<TAB>表示」で渡し、番号は表示しない。選ばれた行の番号で元の項目に戻す
    line="$(for opt in "$@"; do
      printf '%d\t%s\n' "$i" "$opt"
      i=$((i + 1))
    done | "$fzf" --delimiter "$tab" --with-nth 2.. --height 40% --reverse \
      --header "$title  $(msg FZF_HINT)")"
    status=$?
    case "$status" in
      0)
        CHOICE="${line%%"$tab"*}"
        case "$CHOICE" in
          "" | *[!0-9]*) cancelled ;;
        esac
        [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le $# ] || cancelled
        return 0
        ;;
      1 | 130) cancelled ;; # 1: 該当なし  130: Esc / Ctrl-C (fzf(1) の EXIT STATUS)
    esac
  fi
  choose "$title" "$@"
}

# コマンドを実行し、結果と次にやることを表示して、その終了コードで終える
execute() {
  local status op
  echo
  "$@"
  status=$?
  if [ "$status" -eq 0 ]; then
    printf '\n%s%s%s\n' "$G" "$(msg DONE)" "$N"
    if [ -n "$note" ]; then
      printf '%s\n' "$note"
      # 補足を読めるよう、閉じる前に待つ (成功時にターミナルを閉じるタスク向け)
      printf '%s%s%s' "$D" "$(msg PRESS_ENTER)" "$N"
      IFS= read -r _ || true
    fi
  else
    printf '\n%s%s%s\n' "$R" "$(msg FAILED "$status")" "$N"
    op="$(current_op)"
    if [ -n "$op" ]; then
      printf '%s\n' "$(msg STOPPED "$op")"
      [ "$op" = merge ] && printf '%s\n' "$(msg MERGE_PANEL_HINT)"
    fi
  fi
  exit "$status"
}

# merge / rebase の対象を決める。ref があれば ref、無ければコミット。rev / disp / target を設定する
resolve_target() {
  local sha="$1" ref="$2"
  if has_ref "$ref"; then
    git_has "$ref^{commit}" || nothing_to_do "$(msg REF_NOT_FOUND "$ref")"
    rev="$ref"
    disp="$ref"
    target="$ref ($(commit_summary "$ref"))"
  else
    require_commit "$sha"
    rev="$sha"
    disp="$(git rev-parse --short "$sha")"
    target="$(commit_summary "$sha")"
  fi
}

run_generic() {
  local require=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) mode=confirm ;;
      --danger) mode=danger ;;
      --message | --note | --require)
        [ $# -ge 2 ] || usage_error "$(msg NEEDS_VALUE "$1")"
        case "$1" in
          --message) message="$2" ;;
          --note) note="$2" ;;
          --require) require="$2" ;;
        esac
        shift
        ;;
      --)
        shift
        break
        ;;
      *) usage_error "$(msg UNKNOWN_OPTION "$1")" ;;
    esac
    shift
  done
  [ $# -gt 0 ] || usage_error "$(msg NO_COMMAND)"

  require_repo
  case "$require" in
    "") ;;
    merge | rebase | cherry-pick | revert)
      [ "$(current_op)" = "$require" ] || nothing_to_do "$(msg NOT_IN_PROGRESS "$require")"
      ;;
    *) usage_error "$(msg BAD_REQUIRE)" ;;
  esac

  show_context
  show_command "$@"
  show_message
  ask "$mode"
  execute "$@"
}

# ref (ローカルブランチ / リモートブランチ / タグ) をチェックアウトする方法を決める
# plan_kind: branch / tag / current / missing   plan_desc: 説明   plan_cmd / plan_args: コマンド
plan_ref_checkout() {
  local ref="$1" head remote r local_name upstream
  head="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
  plan_kind=branch
  if git_has "refs/heads/$ref"; then
    if [ "$head" = "$ref" ]; then
      plan_kind=current
      plan_desc="$(msg ALREADY_CHECKED_OUT "$ref")"
      return
    fi
    plan_desc="$(msg SWITCH_TO_BRANCH "$ref")"
    plan_cmd="switch"
    plan_args="$ref"
  elif git_has "refs/remotes/$ref"; then
    remote=""
    for r in $(git remote); do
      case "$ref" in
        "$r"/*) [ ${#r} -gt ${#remote} ] && remote="$r" ;;
      esac
    done
    if [ -z "$remote" ]; then
      plan_kind=missing
      plan_desc="$(msg NO_REMOTE_FOR "$ref")"
      return
    fi
    local_name="${ref#"$remote"/}"
    if git_has "refs/heads/$local_name"; then
      if [ "$head" = "$local_name" ]; then
        plan_kind=current
        plan_desc="$(msg ALREADY_CHECKED_OUT "$local_name")"
        return
      fi
      upstream="$(git rev-parse --abbrev-ref "$local_name@{upstream}" 2>/dev/null || true)"
      if [ "$upstream" = "$ref" ]; then
        plan_desc="$(msg SWITCH_TRACKING "$ref" "$local_name")"
      else
        plan_desc="$(msg SWITCH_EXISTING "$local_name" "${upstream:-$(msg NONE)}")"
      fi
      plan_cmd="switch"
      plan_args="$local_name"
    else
      plan_desc="$(msg CREATE_TRACKING "$ref" "$local_name")"
      plan_cmd="track"
      plan_args="$local_name"
    fi
  elif git_has "refs/tags/$ref"; then
    plan_kind=tag
    plan_desc="$(msg TAG_DETACHED "$ref")"
  else
    plan_kind=missing
    plan_desc="$(msg REF_MISSING "$ref")"
  fi
}

run_checkout() {
  [ $# -eq 2 ] || usage "checkout <sha> <ref|@>"
  local sha="$1" ref="$2" short already=0
  require_repo
  require_commit "$sha"
  short="$(git rev-parse --short "$sha")"
  if ! git symbolic-ref -q HEAD >/dev/null 2>&1 &&
    [ "$(git rev-parse HEAD)" = "$(git rev-parse "$sha^{commit}")" ]; then
    already=1
  fi

  if has_ref "$ref"; then
    # origin/HEAD などのシンボリック ref は、指している先に置き換える
    if git symbolic-ref -q "refs/remotes/$ref" >/dev/null 2>&1; then
      ref="$(git symbolic-ref --short "refs/remotes/$ref")"
    fi
    target="$ref ($(commit_summary "$sha"))"
    plan_ref_checkout "$ref"
    case "$plan_kind" in
      current | missing) nothing_to_do "$plan_desc" ;;
      tag)
        message="$plan_desc"
        set -- git switch --detach "$ref"
        ;;
      branch)
        show_context
        choose "$(msg CHECKOUT_TITLE)" \
          "$plan_desc" \
          "$(msg CHECKOUT_DETACHED_OPT "$short")"
        if [ "$CHOICE" = 1 ]; then
          if [ "$plan_cmd" = track ]; then
            set -- git switch -c "$plan_args" --track "$ref"
          else
            set -- git switch "$plan_args"
          fi
        else
          [ "$already" = 1 ] && nothing_to_do "$(msg ALREADY_AT_COMMIT)"
          set -- git switch --detach "$sha"
        fi
        echo
        show_command "$@"
        execute "$@"
        ;;
    esac
  else
    target="$(commit_summary "$sha")"
    [ "$already" = 1 ] && nothing_to_do "$(msg ALREADY_AT_COMMIT)"
    message="$(msg DETACHED_WARN)"
    set -- git switch --detach "$sha"
  fi

  show_context
  show_command "$@"
  show_message
  ask confirm
  execute "$@"
}

run_create_branch() {
  [ $# -eq 1 ] || usage "create-branch <sha>"
  local sha="$1" name ans
  require_repo
  require_commit "$sha"
  target="$(commit_summary "$sha")"
  show_context

  while :; do
    printf '\n%s' "$(msg NEW_BRANCH_PROMPT)"
    IFS= read -r name || name=""
    # 前後の空白を取り除く
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [ -n "$name" ] || cancelled
    if ! git check-ref-format --branch "$name" >/dev/null 2>&1; then
      printf '%s%s%s\n' "$R" "$(msg BAD_BRANCH_NAME "$name")" "$N"
      continue
    fi
    if git_has "refs/heads/$name"; then
      printf '%s%s%s\n' "$R" "$(msg BRANCH_EXISTS "$name")" "$N"
      continue
    fi
    break
  done

  msg ASK_CHECKOUT_TOO
  IFS= read -r ans || ans=""
  if is_yes "$ans"; then
    set -- git switch -c "$name" "$sha"
  else
    set -- git branch "$name" "$sha"
  fi
  echo
  show_command "$@"
  execute "$@"
}

run_merge() {
  [ $# -eq 2 ] || usage "merge <sha> <ref|@>"
  require_repo
  resolve_target "$1" "$2"
  [ "$rev" = "$(git symbolic-ref --short -q HEAD)" ] && nothing_to_do "$(msg MERGE_SELF)"
  show_context
  choose "$(msg MERGE_TITLE "$disp")" \
    "$(msg MERGE_OPT_NORMAL)" \
    "$(msg MERGE_OPT_NOFF)" \
    "$(msg MERGE_OPT_SQUASH)"
  case "$CHOICE" in
    1) set -- git merge --no-edit "$rev" ;;
    2) set -- git merge --no-ff --no-edit "$rev" ;;
    3)
      set -- git merge --squash "$rev"
      note="$(msg NOTE_STAGED)"
      ;;
  esac
  echo
  show_command "$@"
  execute "$@"
}

run_rebase() {
  [ $# -eq 2 ] || usage "rebase <sha> <ref|@>"
  require_repo
  resolve_target "$1" "$2"
  show_context
  choose "$(msg REBASE_TITLE "$disp")" \
    "$(msg REBASE_OPT_NORMAL)" \
    "$(msg REBASE_OPT_INTERACTIVE)"
  case "$CHOICE" in
    1) set -- git rebase "$rev" ;;
    2) set -- git rebase -i "$rev" ;;
  esac
  echo
  show_command "$@"
  execute "$@"
}

# run_pick cherry-pick|revert <sha> [options...]
run_pick() {
  local op="$1" sha="$2" parents merge_commit=0 chosen=0 arg
  shift 2
  require_repo
  require_commit "$sha"
  target="$(commit_summary "$sha")"
  # shellcheck disable=SC2046
  parents="$(count_args $(git rev-list --parents -n 1 "$sha"))"
  [ "$parents" -gt 2 ] && merge_commit=1

  case "$op" in
    cherry-pick) message="$(msg PICK_DESC)" ;;
    revert) message="$(msg REVERT_DESC)" ;;
  esac
  [ "$merge_commit" = 1 ] && message="$message $(msg MERGE_COMMIT_NOTE)"

  if [ "$op" = cherry-pick ] && [ $# -eq 0 ]; then
    show_context
    show_message
    choose "$(msg PICK_TITLE)" \
      "$(msg PICK_OPT_NORMAL)" \
      "$(msg PICK_OPT_X)" \
      "$(msg PICK_OPT_NOCOMMIT)"
    case "$CHOICE" in
      2) set -- -x ;;
      3) set -- --no-commit ;;
    esac
    chosen=1
  fi

  case "$op" in
    cherry-pick) set -- git cherry-pick "$@" ;;
    revert) set -- git revert --no-edit "$@" ;;
  esac
  [ "$merge_commit" = 1 ] && set -- "$@" -m 1
  set -- "$@" "$sha"
  for arg in "$@"; do
    case "$arg" in
      -n | --no-commit) note="$(msg NOTE_STAGED)" ;;
    esac
  done

  if [ "$chosen" = 1 ]; then
    echo
    show_command "$@"
    execute "$@"
  fi
  show_context
  show_command "$@"
  show_message
  ask confirm
  execute "$@"
}

# ブランチの upstream を "remote/branch" の形で出力する (無ければ何も出力しない)
branch_upstream() {
  local up_remote up_merge
  up_remote="$(git config "branch.$1.remote" 2>/dev/null)" || return 0
  up_merge="$(git config "branch.$1.merge" 2>/dev/null)" || return 0
  if [ "$up_remote" = "." ]; then
    printf '%s\n' "$(msg LOCAL_UPSTREAM "${up_merge#refs/heads/}")"
  else
    printf '%s/%s\n' "$up_remote" "${up_merge#refs/heads/}"
  fi
}

# 引数なしの git push が使うリモートを出力する
# (branch.<b>.pushRemote → remote.pushDefault → branch.<b>.remote → origin。git-config(1) の説明どおり)
default_push_remote() {
  local r
  r="$(git config "branch.$1.pushRemote" 2>/dev/null)" ||
    r="$(git config remote.pushDefault 2>/dev/null)" ||
    r="$(git config "branch.$1.remote" 2>/dev/null)" ||
    r=origin
  printf '%s\n' "$r"
}

# push 先のリモートを選ばせて remote に入れる。1 つしか無ければ聞かずにそれを使う
# 既定のリモートを先頭に置いて印を付け、残りは名前順に並べる
choose_push_remote() {
  local branch="$1" default r w=0 opt
  local -a names=() opts=()
  default="$(default_push_remote "$branch")"
  git remote get-url "$default" >/dev/null 2>&1 && names=("$default")
  for r in $(git remote | sort); do
    [ "$r" = "$default" ] || names+=("$r")
  done
  [ ${#names[@]} -gt 0 ] || nothing_to_do "$(msg NO_REMOTES)"
  if [ ${#names[@]} -eq 1 ]; then
    remote="${names[0]}"
    return
  fi
  for r in "${names[@]}"; do
    [ ${#r} -gt "$w" ] && w=${#r}
  done
  for r in "${names[@]}"; do
    opt="$(printf "%-${w}s  %s" "$r" "$(git remote get-url --push "$r" 2>/dev/null)")"
    [ "$r" = "$default" ] && opt="$opt $(msg PUSH_REMOTE_DEFAULT)"
    opts+=("$opt")
  done
  choose_name "$(msg PUSH_REMOTE_TITLE)" "${opts[@]}"
  remote="${names[$((CHOICE - 1))]}"
  echo
}

run_push() {
  { [ $# -ge 1 ] && [ $# -le 2 ]; } || usage "push <branch> [remote]"
  local branch="$1" remote="${2-}" refspec counts upstream ans
  local set_upstream=""
  require_repo
  git_has "refs/heads/$branch" || nothing_to_do "$(msg NOT_LOCAL_BRANCH "$branch")"
  if [ -n "$remote" ]; then
    git remote get-url "$remote" >/dev/null 2>&1 || nothing_to_do "$(msg NO_SUCH_REMOTE "$remote")"
    show_context
  else
    show_context
    choose_push_remote "$branch"
  fi
  if git_has "refs/remotes/$remote/$branch"; then
    counts="$(git rev-list --left-right --count "refs/heads/$branch...refs/remotes/$remote/$branch")"
    target="$(msg PUSH_TARGET_DIFF "$branch" "$remote" "$remote/$branch" \
      "${counts%%[[:space:]]*}" "${counts##*[[:space:]]}")"
  else
    target="$(msg PUSH_TARGET_NEW "$branch" "$remote" "$remote")"
  fi
  refspec="refs/heads/$branch:refs/heads/$branch"
  upstream="$(branch_upstream "$branch")"

  show_field LABEL_TARGET "$target"
  show_field LABEL_UPSTREAM "${upstream:-$(msg NONE)}"
  choose "$(msg PUSH_TITLE)" \
    "$(msg PUSH_OPT_NORMAL)" \
    "$(msg PUSH_OPT_LEASE)" \
    "$(msg PUSH_OPT_FORCE)"

  # 既に同じ upstream なら -u を付けても変わらないので聞かない
  if [ "$upstream" != "$remote/$branch" ]; then
    msg ASK_UPSTREAM "$remote/$branch" "${upstream:-$(msg NONE)}"
    IFS= read -r ans || ans=""
    is_yes "$ans" && set_upstream="-u"
  fi

  case "$CHOICE" in
    1) set -- git push ;;
    2)
      mode=danger
      message="$(msg LEASE_WARN "$remote/$branch" "$branch")"
      set -- git push --force-with-lease --force-if-includes
      ;;
    3)
      mode=danger
      message="$(msg FORCE_WARN "$remote/$branch")"
      set -- git push --force
      ;;
  esac
  [ -n "$set_upstream" ] && set -- "$@" "$set_upstream"
  set -- "$@" "$remote" "$refspec"
  echo
  show_command "$@"
  show_message
  ask "$mode"
  execute "$@"
}

run_continue() {
  [ $# -eq 0 ] || usage "continue"
  local op unmerged
  require_repo
  op="$(current_op)"
  [ -n "$op" ] || nothing_to_do "$(msg NOTHING_IN_PROGRESS)"
  unmerged="$(git diff --name-only --diff-filter=U)"
  if [ -n "$unmerged" ]; then
    printf '%s%s%s\n%s\n' "$R" "$(msg UNRESOLVED)" "$N" "$unmerged"
    exit 1
  fi
  # コミットメッセージのエディタを開かず、Git が用意したメッセージをそのまま使う
  export GIT_EDITOR=true
  message="$(msg CONTINUE_DESC "$op")"
  set -- git "$op" --continue

  show_context
  show_command "$@"
  show_message
  execute "$@"
}

run_abort() {
  [ $# -eq 0 ] || usage "abort"
  local op
  require_repo
  op="$(current_op)"
  [ -n "$op" ] || nothing_to_do "$(msg NOTHING_IN_PROGRESS)"
  message="$(msg ABORT_DESC "$op")"
  set -- git "$op" --abort

  show_context
  show_command "$@"
  show_message
  ask confirm
  execute "$@"
}

case "${1-}" in
  checkout | create-branch | merge | rebase | push | continue | abort)
    cmd="$1"
    shift
    case "$cmd" in
      checkout) run_checkout "$@" ;;
      create-branch) run_create_branch "$@" ;;
      merge) run_merge "$@" ;;
      rebase) run_rebase "$@" ;;
      push) run_push "$@" ;;
      continue) run_continue "$@" ;;
      abort) run_abort "$@" ;;
    esac
    ;;
  cherry-pick | revert)
    [ $# -ge 2 ] || usage "$1 <sha> [options]"
    run_pick "$@"
    ;;
  *) run_generic "$@" ;;
esac
